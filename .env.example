# Copy to .env and fill in. Never commit .env.

# mock (default, no key needed) | anthropic | openai
LLM_PROVIDER=mock

# Model name for the chosen provider, e.g. a Claude or GPT model your account can use
LLM_MODEL=

# Only the key for your chosen provider is needed
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
